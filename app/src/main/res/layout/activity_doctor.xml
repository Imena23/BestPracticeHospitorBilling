<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_background">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/md_primary" android:orientation="horizontal"
        android:padding="16dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:id="@+id/tv_welcome"
            android:textColor="@color/md_on_primary" android:textSize="18sp" android:textStyle="bold"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Logout"
            android:textColor="@color/md_on_primary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:strokeColor="@color/md_on_primary"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
        <TextView android:id="@+id/tv_patient_label" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="No patient selected" android:textSize="14sp"
            android:textColor="@color/md_on_surface_variant"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_select_patient" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Select Patient"
            style="@style/App.Button.Primary"/>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Prescriptions"/>
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Lab Orders"/>
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Nurse Tasks"/>
    </com.google.android.material.tabs.TabLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_order"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="12dp" android:text="+ Add Order / Task"
        style="@style/App.Button.Primary"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>

</LinearLayout>
