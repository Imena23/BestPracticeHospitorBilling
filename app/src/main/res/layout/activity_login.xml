<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/md_primary"
        android:gravity="center"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🏥" android:textSize="44sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="MediPay"
            android:textColor="@color/md_on_primary" android:textSize="26sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Hospital Billing System"
            android:textColor="@color/md_primary_container" android:textSize="13sp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">

            <!-- Role toggle -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/md_primary"
                app:tabSelectedTextColor="@color/md_primary"
                app:tabTextColor="@color/md_on_surface_variant"
                android:background="@color/md_surface_variant">
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Patient"/>
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Staff / Admin"/>
            </com.google.android.material.tabs.TabLayout>

            <TextView android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Enter your details to access your billing information"
                android:textColor="@color/md_on_surface_variant" android:textSize="14sp"/>

            <!-- ── Patient fields ── -->
            <LinearLayout android:id="@+id/layout_patient"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Full Name" style="@style/App.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_name" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:textColor="@color/md_on_surface" android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:hint="Date of Birth"
                    style="@style/App.TextInputLayout"
                    app:startIconDrawable="@android:drawable/ic_menu_my_calendar">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_dob" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="DD/MM/YYYY"
                        android:inputType="none" android:focusable="false" android:clickable="true"
                        android:textColor="@color/md_on_surface" android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:hint="4-Digit PIN"
                    style="@style/App.TextInputLayout"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@android:drawable/ic_lock_lock">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_pin" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberPassword"
                        android:maxLength="4" android:textColor="@color/md_on_surface" android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- ── Staff fields ── -->
            <LinearLayout android:id="@+id/layout_staff"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Username" style="@style/App.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_username" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="text"
                        android:textColor="@color/md_on_surface" android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:hint="Password"
                    style="@style/App.TextInputLayout"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@android:drawable/ic_lock_lock">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textPassword"
                        android:textColor="@color/md_on_surface" android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Error -->
            <TextView android:id="@+id/tv_error"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textColor="@color/md_error"
                android:textSize="13sp" android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="24dp" android:text="Login"
                android:textSize="16sp" style="@style/App.Button.Primary"/>

            <TextView android:id="@+id/tv_demo_hint"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:gravity="center"
                android:text="Demo: John Doe · PIN 1234   |   Jane Smith · PIN 5678"
                android:textColor="@color/md_outline" android:textSize="12sp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:gravity="center" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="New patient? " android:textColor="@color/md_on_surface_variant"
                    android:textSize="14sp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tv_goto_register" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Register"
                    android:textSize="14sp" style="@style/App.Button.Text"
                    android:insetTop="0dp" android:insetBottom="0dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
