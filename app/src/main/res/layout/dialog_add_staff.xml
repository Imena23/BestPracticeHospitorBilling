<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Full Name" style="@style/App.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textPersonName|textCapWords"/>
    </com.google.android.material.textfield.TextInputLayout>

    <Spinner android:id="@+id/sp_role" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_marginTop="12dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:hint="Username" style="@style/App.TextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_username" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:hint="Password"
        style="@style/App.TextInputLayout" app:endIconMode="password_toggle">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_password" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
