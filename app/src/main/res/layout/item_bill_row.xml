<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_bill_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consultation Fee"
            android:textColor="@color/md_on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_bill_item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Mar 28, 2026"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_bill_item_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RWF 0"
            android:textColor="@color/md_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- MDC Chip as status badge -->
        <com.google.android.material.chip.Chip
            android:id="@+id/tv_bill_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Unpaid"
            android:textSize="11sp"
            style="@style/Widget.Material3.Chip.Assist"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>

</LinearLayout>
